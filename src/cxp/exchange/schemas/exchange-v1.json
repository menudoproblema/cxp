{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cxp:schema:exchange:1",
  "title": "CXP document exchange v1",
  "$defs": {
    "identity": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*[:.][\\x21-\\x7E]+$",
          "not": {
            "pattern": "[\\r\\n]"
          }
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$",
          "not": {
            "pattern": "[\\r\\n]"
          }
        },
        "version": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
          "not": {
            "pattern": "[\\r\\n]"
          }
        }
      },
      "required": [
        "namespace",
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*[:.][\\x21-\\x7E]+$",
          "not": {
            "pattern": "[\\r\\n]"
          }
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$",
          "not": {
            "pattern": "[\\r\\n]"
          }
        },
        "version": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
          "not": {
            "pattern": "[\\r\\n]"
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "not": {
            "pattern": "[\\r\\n]"
          }
        }
      },
      "required": [
        "namespace",
        "name",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "quantity": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "not": {
            "pattern": "[\\r\\n]"
          }
        },
        "unit": {
          "enum": [
            "um",
            "mm",
            "in",
            "pt",
            "g",
            "kg",
            "dpi",
            "deg"
          ]
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "value": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "maxLength": 16384
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 16384
          },
          "maxItems": 1000,
          "uniqueItems": true
        },
        {
          "$ref": "#/$defs/quantity"
        }
      ]
    },
    "property": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "string",
            "boolean",
            "integer",
            "decimal",
            "quantity",
            "string_set"
          ]
        },
        "dimension": {
          "enum": [
            "length",
            "mass",
            "resolution",
            "angle"
          ]
        },
        "nullable": {
          "type": "boolean"
        },
        "null_meaning": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "maxLength": 16384
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "quantity"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "dimension"
            ]
          },
          "else": {
            "not": {
              "required": [
                "dimension"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "nullable": {
                "const": true
              }
            },
            "required": [
              "nullable"
            ]
          },
          "then": {
            "required": [
              "null_meaning"
            ]
          },
          "else": {
            "not": {
              "required": [
                "null_meaning"
              ]
            }
          }
        }
      ]
    },
