        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "window_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "state"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "key": [
          "scope",
          "window_seconds"
        ],
        "scope": [
          "key",
          "window_seconds"
        ],
        "window_seconds": [
          "key",
          "scope"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "unknown",
                  "not_idempotent"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "key"
                  ]
                },
                {
                  "required": [
                    "scope"
                  ]
                },
                {
                  "required": [
                    "window_seconds"
                  ]
                }
