{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cxp:schema:context:2",
  "title": "CXP context v2",
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
      "maxLength": 27,
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "configuration_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "as_of": {
          "$ref": "#/$defs/timestamp"
        },
        "max_age_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "accepted_sources": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "declared",
              "observed",
              "tested"
            ]
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        }
      },
      "required": [
        "subject_id",
        "configuration_revision",
        "accepted_sources"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "max_age_seconds": [
          "as_of"
        ]
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "document_type": {
          "const": "cxp.context"
        },
        "spec_version": {
          "const": 2
        },
        "payload": {
          "$ref": "#/$defs/context"
        },
        "extensions": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*[:.][\\x21-\\x7E]+$",
            "not": {
              "pattern": "[\\r\\n]"
            }
          }
        },
        "critical_extensions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 1000,
          "uniqueItems": true
        }
      },
      "required": [
        "document_type",
        "spec_version",
        "payload"
      ],
      "additionalProperties": false
    }
  ]
}
